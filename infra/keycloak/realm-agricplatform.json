{
  "realm": "agricplatform",
  "enabled": true,
  "displayName": "AgricPlatform (integration fabric)",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "sslRequired": "none",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 28800,
  "roles": {
    "realm": [
      { "name": "farmer", "description": "Registered farmer member" },
      { "name": "buyer", "description": "Marketplace buyer" },
      { "name": "partner", "description": "Partner organisation user" },
      { "name": "chapter_lead", "description": "Chapter leadership role" },
      { "name": "lender", "description": "Credit lender staff (input-finance / MFB partners)" },
      { "name": "enumerator", "description": "Field agent capturing farmer data" },
      { "name": "admin", "description": "Platform administrator" }
    ],
    "client": {
      "agric-api": [
        { "name": "api:read", "description": "Read access through the API" },
        { "name": "api:write", "description": "Write access through the API" }
      ],
      "agric-web": []
    }
  },
  "groups": [
    {
      "name": "members",
      "subGroups": [
        { "name": "farmers", "realmRoles": ["farmer"] },
        { "name": "buyers", "realmRoles": ["buyer"] }
      ]
    },
    {
      "name": "field-staff",
      "subGroups": [
        { "name": "enumerators", "realmRoles": ["enumerator"] },
        { "name": "chapter-leads", "realmRoles": ["chapter_lead"] }
      ]
    },
    {
      "name": "partners",
      "subGroups": [
        { "name": "lenders", "realmRoles": ["lender"] },
        { "name": "partner-orgs", "realmRoles": ["partner"] }
      ]
    },
    { "name": "staff", "realmRoles": ["admin"] }
  ],
  "defaultRoles": ["farmer"],
  "clients": [
    {
      "clientId": "agric-web",
      "name": "AgricPlatform Web PWA",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "defaultClientScopes": ["openid", "profile", "email", "roles"]
    },
    {
      "clientId": "agric-api",
      "name": "AgricPlatform API (confidential resource server)",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "secret": "CHANGE-ME-local-dev-only",
      "attributes": {
        "use.refresh.tokens": "false",
        "note": "LOCAL DEV PLACEHOLDER SECRET. Override with a real secret via Keycloak admin and export it to the API as OIDC_CLIENT_SECRET / KEYCLOAK_CLIENT_SECRET. Never commit a real secret."
      },
      "defaultClientScopes": ["openid", "profile", "email", "roles"]
    }
  ],
  "clientScopes": [],
  "browserFlow": "browser",
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "ha", "yo", "ig"],
  "defaultLocale": "en",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "passwordPolicy": "length(8) and notUsername and notEmail",
  "eventsEnabled": true,
  "eventsListeners": ["jboss-logging"]
}
