{
  "realm": "agric-platform",
  "enabled": true,
  "displayName": "AgricPlatform (local dev)",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": false,
  "sslRequired": "none",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 28800,
  "roles": {
    "realm": [
      { "name": "farmer", "description": "Registered farmer member" },
      { "name": "student", "description": "Student / academy learner" },
      { "name": "buyer", "description": "Marketplace buyer" },
      { "name": "supplier", "description": "Input and service supplier" },
      { "name": "chapter_lead", "description": "Chapter leadership role" },
      { "name": "partner", "description": "Partner organisation user" },
      { "name": "admin", "description": "Platform administrator" }
    ],
    "client": {
      "agric-api": [
        { "name": "api:read", "description": "Read access through the API" },
        { "name": "api:write", "description": "Write access through the API" }
      ],
      "agric-web": [],
      "agric-service": []
    }
  },
  "groups": [
    {
      "name": "members",
      "subGroups": [
        { "name": "farmers", "realmRoles": ["farmer"] },
        { "name": "students", "realmRoles": ["student"] }
      ]
    },
    { "name": "staff", "realmRoles": ["admin"] }
  ],
  "defaultRoles": ["farmer"],
  "clients": [
    {
      "clientId": "agric-web",
      "name": "AgricPlatform Web PWA",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "defaultClientScopes": ["openid", "profile", "email", "roles"]
    },
    {
      "clientId": "agric-api",
      "name": "AgricPlatform API (resource server)",
      "enabled": true,
      "publicClient": true,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "defaultClientScopes": ["openid", "profile", "email", "roles"]
    },
    {
      "clientId": "agric-service",
      "name": "AgricPlatform service-to-service (webhooks, workers)",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "attributes": {
        "use.refresh.tokens": "false",
        "note": "Client secret is generated by Keycloak at import time; never commit it."
      },
      "defaultClientScopes": ["openid", "roles"]
    }
  ],
  "clientScopes": [],
  "browserFlow": "browser",
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "ha", "yo", "ig"],
  "defaultLocale": "en",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "failureFactor": 5,
  "passwordPolicy": "length(8) and notUsername and notEmail",
  "eventsEnabled": true,
  "eventsListeners": ["jboss-logging"],
  "enabledEventTypes": ["LOGIN", "LOGIN_ERROR", "REGISTER", "LOGOUT"],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true
}
