# Keycloak 26.7 native OpenTelemetry (stage 25 / wave W4).
# Keycloak ships a built-in OTel integration since v25 — no agent needed.
# Paste these into the `keycloak` service `environment:` block in
# infra/docker-compose.yml (integrator: W3), keeping the existing
# KC_HEALTH_ENABLED / bootstrap-admin entries.

# --- Tracing ---
KC_TRACING_ENABLED=true
KC_TRACING_SERVICE_NAME=keycloak
# OTLP gRPC to the platform hub collector (see
# infra/observability/otel-collector-config.yaml).
KC_TRACING_ENDPOINT=http://otel-collector:4317
# 1.0 = trace everything in local dev. Use e.g. 0.1 in production.
KC_TRACING_SAMPLER_RATIO=1.0
# Optional: KC_TRACING_PROTOCOL=grpc (default; use http/protobuf only if the
# collector endpoint switches to :4318).

# --- Metrics ---
# Exposes micrometer metrics at http://keycloak:8080/metrics (management
# port 9000/metrics when KC_HTTP_MANAGEMENT_* is configured). The hub
# collector does NOT scrape this in the default config — keycloak sends
# traces over OTLP; add a prometheus scrape job if metrics are wanted:
#   - job_name: keycloak
#     metrics_path: /metrics
#     static_configs: [{targets: [keycloak:8080]}]
KC_METRICS_ENABLED=true

