# Core
NODE_ENV=development
APP_NAME=AgricPlatform
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
PORT=3001

# Web (Next.js public env — documentation only, no secrets)
# Base URL of the NestJS API consumed by the browser client.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Persistence (PostgreSQL + Redis)
# DATABASE_URL selects the pg repositories; without it the API boots on the
# in-memory implementations (development/test only). In production boot fails
# closed unless ALLOW_INMEMORY_PERSISTENCE=true is set explicitly (break-glass
# local drills only — state is lost on restart).
DATABASE_URL=postgresql://agric:agric@localhost:5432/agric_platform
ALLOW_INMEMORY_PERSISTENCE=false
# REDIS_URL selects the shared idempotency/OTP stores; without it in-memory
# stores keep single-instance semantics. Production fails closed unless
# ALLOW_INMEMORY_CACHE=true (break-glass only).
REDIS_URL=redis://localhost:6379
ALLOW_INMEMORY_CACHE=false
# After provisioning the database:
#   npm run migrate -w @agric-platform/api   (apply infra/postgres/*.sql)
#   npm run seed -w @agric-platform/api      (load demo seed data)

# Identity
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=agric-platform
KEYCLOAK_CLIENT_ID=agric-web
KEYCLOAK_CLIENT_SECRET=replace-me
# API-side OIDC verification (required in production)
OIDC_ISSUER=http://localhost:8080/realms/agric-platform
OIDC_AUDIENCE=agric-web
ALLOW_DEV_HEADER_AUTH=false
ENABLE_API_DOCS=false

# Integration drivers: stub | sandbox | production
SMS_DRIVER=stub
WHATSAPP_DRIVER=stub
EMAIL_DRIVER=stub
PUSH_DRIVER=stub
PAYMENT_DRIVER=stub
SEARCH_DRIVER=stub
WEATHER_DRIVER=stub
LMS_DRIVER=stub
COMMUNITY_DRIVER=stub
CMS_DRIVER=stub

# Provider credentials (never commit real values)
TERMII_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_360DIALOG_API_KEY=
MAILGUN_API_KEY=
SENDGRID_API_KEY=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=
MOODLE_BASE_URL=
MOODLE_TOKEN=
DISCOURSE_BASE_URL=
DISCOURSE_API_KEY=
DIRECTUS_BASE_URL=
DIRECTUS_TOKEN=

# --- Wave P1 live provider drivers (documentation only — no real secrets) ---
# SMS: Termii primary + Twilio failover. Live SMS_DRIVER requires Termii
# (key + registered sender) or the full Twilio triple.
TERMII_SENDER_ID=
TWILIO_FROM_NUMBER=
# WhatsApp via 360dialog: WABA namespace for approved templates (optional).
WHATSAPP_360DIALOG_NAMESPACE=
# Email: Mailgun preferred (key + domain); SendGrid alternate. EMAIL_FROM
# overrides the default sender for both.
MAILGUN_DOMAIN=
EMAIL_FROM=
# Flutterwave webhook verif-hash (native scheme; the shared HMAC path uses
# WEBHOOK_SIGNING_SECRET / <PREFIX>_WEBHOOK_SECRET).
FLUTTERWAVE_VERIF_HASH=
# Search: Meilisearch index name override (default agric-platform).
MEILISEARCH_INDEX=
# Weather: WEATHER_DRIVER=sandbox|production enables the keyless Open-Meteo
# feed (no credentials) with a 15-minute Redis/in-memory cache.
# Market data: scheduled FEWS NET / NiMet price ingestion into
# advisory.commodity_prices; enabled only with MARKET_DATA_DRIVER=live (or
# sandbox/production) AND at least one feed key.
MARKET_DATA_DRIVER=stub
FEWS_NET_API_KEY=
NIMET_API_KEY=
FEWS_NET_BASE_URL=
NIMET_BASE_URL=
MARKET_DATA_POLL_INTERVAL_MS=
# Discourse API username for the bridge client (default: system).
DISCOURSE_API_USERNAME=

# --- Wave P5b USSD channel (documentation only — no real secrets) ---
# Africa's Talking USSD callback (POST /api/v1/ussd/callback) stays disabled
# until USSD_DRIVER=live|sandbox AND both credentials are set. In production
# the API refuses to boot when the driver flag is set without the
# credentials (fail-closed, same pattern as the wave P1 adapters).
USSD_DRIVER=stub
AT_API_KEY=
AT_USERNAME=
# Callback authenticity (audit C2-3): AT does NOT sign callbacks, so the
# callback URLs configured in the AT dashboard must embed this shared secret
# as a query param (e.g. .../ussd/callback?token=<value>); the
# x-at-callback-token header is accepted too. Applies to all three AT
# callbacks (ussd, ivr, agent-banking/ussd). Production refuses to boot a
# live|sandbox driver without it. Generate per environment
# (openssl rand -hex 32) — never commit a real value.
AT_CALLBACK_TOKEN=replace-me
# Optional comma-separated source-IP allowlist for the AT callbacks
# (empty = disabled). 403s any caller outside the list.
AT_CALLBACK_IP_ALLOWLIST=
# Session sweeper cadence override (default 60000 ms; sessions themselves
# expire after a fixed 3-minute inactivity window).
USSD_SWEEP_INTERVAL_MS=
# --- End wave P5b block ---

# --- Wave P6a IVR voice channel (documentation only — no real secrets) ---
# Africa's Talking Voice callback (POST /api/v1/ivr/callback) stays disabled
# until IVR_DRIVER=live|sandbox AND both credentials are set (the same
# AT_API_KEY/AT_USERNAME pair as USSD). In production the API refuses to
# boot when the driver flag is set without the credentials (fail-closed,
# same pattern as the wave P1 adapters). The callback is authenticated by
# the shared AT_CALLBACK_TOKEN / AT_CALLBACK_IP_ALLOWLIST (see the wave P5b
# block above).
IVR_DRIVER=stub
# Call sweeper cadence override (default 60000 ms; call rows themselves
# expire after a fixed 10-minute inactivity window).
IVR_SWEEP_INTERVAL_MS=
# --- End wave P6a block ---

# --- Wave AGENTBANK agent banking (documentation only — no real secrets) ---
# HMAC key for the signed offline-voucher payload. Development falls back to
# a clearly-labelled INSECURE default; in production the API refuses to boot
# without a real secret (fail-closed, same pattern as the signing keys).
# Generate per environment (e.g. openssl rand -hex 32) and store only in the
# GitHub Environment / cloud secret manager — never commit a real value.
AGENT_VOUCHER_SECRET=
# Farmer presence-proof (OTP) driver. stub (default): deterministic dev
# channel, nothing is sent — FORBIDDEN in production (the stub code is
# publicly computable; production boot aborts unless OTP_DRIVER=live).
# live: reserved for a real OTP vendor — requires both credentials and fails
# closed (503 on every verification) until a provider client is integrated;
# production boots refuse missing config.
OTP_DRIVER=stub
OTP_PROVIDER_URL=
OTP_PROVIDER_API_KEY=
# --- End wave AGENTBANK block ---

# --- Wave NINVOUCHER input vouchers (documentation only — no real secrets) ---
# Salt for the salted-HMAC NIN hash (plaintext NIN is NEVER persisted — only
# hash + last-3 mask). Development falls back to a clearly-labelled dev
# default; production refuses to boot without a real per-environment salt.
NIN_HASH_SALT=
# Identity verification driver. stub (default): deterministic, clearly
# labelled. live: reserved for NIMC/licensed vendor — requires both
# credentials, fails closed (503) until integrated; production aborts when
# the flag is set without config.
NIN_DRIVER=stub
NIN_PROVIDER_URL=
NIN_PROVIDER_API_KEY=
# --- End wave NINVOUCHER block ---

# --- Wave LIVESTOCK passport (documentation only — no real secrets) ---
# HMAC key for the public livestock-passport verification codes. Development
# falls back to a clearly-labelled INSECURE default; production refuses to
# boot without a real secret (fail-closed, same pattern as the signing keys).
LIVESTOCK_PASSPORT_SECRET=
# National animal-ID authority port. stub (default): deterministic, clearly
# labelled STUB-NAIS-*. live: reserved for the state veterinary authority /
# RFID tag registry — requires both credentials, fails closed (503) until
# integrated; production aborts when the flag is set without config.
ANIMAL_ID_AUTHORITY_MODE=stub
ANIMAL_ID_AUTHORITY_URL=
ANIMAL_ID_AUTHORITY_API_KEY=
# --- End wave LIVESTOCK block ---

# Security
JWT_SECRET=local-development-only
WEBHOOK_SIGNING_SECRET=local-development-only

# ---------------------------------------------------------------------------
# Phase 3 federated integrations (wave P5a; docs/integration-matrix.md).
# All default to stub (inert, no network I/O). A non-stub driver flag
# without the full credential set fails closed at boot (ProviderConfigError).
# Documentation placeholders only — never commit real values.
# ---------------------------------------------------------------------------

# farmOS / LiteFarm farm-record sync (polling + webhook push receiver).
FARM_RECORDS_DRIVER=stub
FARMOS_BASE_URL=
FARMOS_API_KEY=
LITEFARM_BASE_URL=
LITEFARM_API_KEY=
# Shared-secret webhook tokens (x-integration-token) for push receivers;
# required in production.
FARMOS_WEBHOOK_TOKEN=
LITEFARM_WEBHOOK_TOKEN=

# Open Food Network syndication (push listings, receive order events).
OFN_DRIVER=stub
OFN_BASE_URL=
OFN_API_KEY=
OFN_ENTERPRISE_ID=
OFN_WEBHOOK_TOKEN=

# NCX / AFEX commodity price feeds into advisory.commodity_prices.
EXCHANGE_FEEDS_DRIVER=stub
NCX_BASE_URL=
NCX_API_KEY=
AFEX_FEED_URL=
AFEX_API_KEY=
EXCHANGE_FEEDS_POLL_INTERVAL_MS=

# ODK / KoboToolbox beneficiary import (SFTP pull scaffolded, fail closed).
FIELD_DATA_DRIVER=stub
KOBO_BASE_URL=
KOBO_API_TOKEN=
KOBO_ASSET_UID=
ODK_CENTRAL_BASE_URL=
ODK_CENTRAL_TOKEN=
ODK_PROJECT_ID=
ODK_FORM_ID=
FIELD_DATA_SFTP_HOST=
FIELD_DATA_SFTP_USER=
# wave P6b: SFTP pull transport (ssh2). FIELD_DATA_SFTP_DRIVER=sandbox|live
# enables the source; key auth via inline PEM or a key path, else password.
FIELD_DATA_SFTP_DRIVER=stub
FIELD_DATA_SFTP_PORT=
FIELD_DATA_SFTP_PRIVATE_KEY=
FIELD_DATA_SFTP_PRIVATE_KEY_PATH=
FIELD_DATA_SFTP_PASSWORD=
FIELD_DATA_SFTP_REMOTE_DIR=
FIELD_DATA_SFTP_TIMEOUT_MS=

# Input-finance lender bridge (consent-gated credit-readiness push).
LENDER_DRIVER=stub
LENDER_BASE_URL=
LENDER_API_KEY=
LENDER_WEBHOOK_TOKEN=

# NAERLS / FMARD e-Extension advisory pull (read-only, scheduled).
EXTENSION_FEED_DRIVER=stub
NAERLS_BASE_URL=
NAERLS_API_KEY=
FMARD_BASE_URL=
FMARD_API_KEY=
EXTENSION_FEED_POLL_INTERVAL_MS=

# ---------------------------------------------------------------------------
# Wave FABRIC middleware drivers (docs/integration-fabric.md).
# Every flag defaults to stub (current behaviour, deterministic, no network
# I/O). Selecting a live driver without its configuration fails CLOSED at
# boot (ProviderConfigError) — the API never silently degrades to the stub.
# Compose profiles in infra/docker-compose.yml provide local dev instances
# (none start by default). Documentation placeholders only — no real secrets.
# ---------------------------------------------------------------------------

# Event bus: stub (in-process outbox + EventEmitter) | kafka (kafkajs).
# kafka requires KAFKA_BROKERS; circuit breaker opens after 3 failures.
# Local broker: docker compose -f infra/docker-compose.yml --profile redpanda up -d
EVENT_BUS_DRIVER=stub
KAFKA_BROKERS=
KAFKA_TOPIC_PREFIX=

# Workflow orchestrator: stub (direct in-process invocation) | temporal.
# temporal requires TEMPORAL_ADDRESS. Worker bootstrap (not auto-started):
#   npm run worker:temporal -w @agric-platform/api
# Local server: docker compose -f infra/docker-compose.yml --profile temporal up -d
WORKFLOW_DRIVER=stub
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_TASK_QUEUE=

# Search: SEARCH_DRIVER=opensearch selects the OpenSearch query-path driver
# (requires OPENSEARCH_NODE); any other value keeps the in-process search.
# Local node: docker compose -f infra/docker-compose.yml --profile opensearch up -d
# (demo security config: node is https + basic auth — set username/password
# and OPENSEARCH_TLS_REJECT_UNAUTHORIZED=false for the demo certs).
OPENSEARCH_NODE=
OPENSEARCH_INDEX=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_TLS_REJECT_UNAUTHORIZED=

# Authorization: stub (current RolesGuard/ownership logic) | permify.
# permify requires PERMIFY_URL; proof scope is credit loan read only.
# Local server: docker compose -f infra/docker-compose.yml --profile permify up -d
AUTHORIZATION_DRIVER=stub
PERMIFY_URL=
PERMIFY_TENANT_ID=

# Ledger backend: stub (Postgres ledger authoritative) | tigerbeetle.
# LEGAL GATE: defaults OFF; tigerbeetle requires BOTH envs and is a
# proof-of-port only — not wired into money movement.
# Local replica: docker compose -f infra/docker-compose.yml --profile tigerbeetle up -d
LEDGER_DRIVER=stub
TIGERBEETLE_ADDRESSES=
TIGERBEETLE_CLUSTER_ID=

# Mojaloop interop: stub (deterministic simulated fixtures) | simulator.
# simulator requires MOJALOOP_SIM_URL (mojaloop-simulator / testing toolkit);
# proves the adapter contract only — no full Mojaloop switch is deployed.
MOJALOOP_DRIVER=stub
MOJALOOP_SIM_URL=

# OpenSearch demo admin password for the compose profile (LOCAL ONLY).
OPENSEARCH_ADMIN_PASSWORD=
# open-appsec SaaS profile token for the compose profile (optional; LOCAL ONLY).
APPSEC_AGENT_TOKEN=
# OIDC client secret for the confidential agric-api client in the
# `agricplatform` realm (placeholder in the realm file; LOCAL ONLY).
OIDC_CLIENT_SECRET=
