# ---------------------------------------------------------------------------
# Wave FABRIC middleware drivers (docs/integration-fabric.md).
# Every flag defaults to stub (current behaviour, deterministic, no network
# I/O). Selecting a live driver without its configuration fails CLOSED at
# boot (ProviderConfigError) — the API never silently degrades to the stub.
# Compose profiles in infra/docker-compose.yml provide local dev instances
# (none start by default). Documentation placeholders only — no real secrets.
# ---------------------------------------------------------------------------

# Event bus: stub (in-process outbox + EventEmitter) | kafka (kafkajs) |
# fluvio (@fluvio/client). kafka requires KAFKA_BROKERS; fluvio requires
# FLUVIO_ENDPOINT (host:port of the SC, compose profile "fluvio" exposes
# localhost:9003); circuit breaker opens after 3 failures.
# Local broker: docker compose -f infra/docker-compose.yml --profile redpanda up -d
EVENT_BUS_DRIVER=stub
KAFKA_BROKERS=
KAFKA_TOPIC_PREFIX=
FLUVIO_ENDPOINT=
FLUVIO_TOPIC_PREFIX=

# OpenTelemetry SDK for the API + temporal worker (apps/api
# src/common/telemetry/telemetry.sdk.ts). Disabled = complete no-op
# (OTEL_ENABLED=false). Endpoint is the hub collector
# (compose profile "observability", service otel-collector; http :4318).
# OTEL_TRACES_SAMPLER_ARG is the head-sampling ratio 0..1 (default 1.0;
# invalid values fall back to the environment default with a warning).
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=agric-api
OTEL_TRACES_SAMPLER_ARG=1.0

# Workflow orchestrator: stub (direct in-process invocation) | temporal.
# temporal requires TEMPORAL_ADDRESS. The worker runs as a separate process
# (WP-G8): the compose "temporal" profile includes a temporal-worker
# service; outside compose run:
#   npm run worker:temporal -w @agric-platform/api
# With WORKFLOW_DRIVER=temporal, /health/ready reports the temporal-worker
# dependency 'down' until a worker polls the task queue.
# Local server: docker compose -f infra/docker-compose.yml --profile temporal up -d
WORKFLOW_DRIVER=stub
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_TASK_QUEUE=

# Search: SEARCH_DRIVER=opensearch selects the OpenSearch query-path driver
# (requires OPENSEARCH_NODE); any other value keeps the in-process search.
# Local node: docker compose -f infra/docker-compose.yml --profile opensearch up -d
# (demo security config: node is https + basic auth — set username/password
# and OPENSEARCH_TLS_REJECT_UNAUTHORIZED=false for the demo certs).
OPENSEARCH_NODE=
OPENSEARCH_INDEX=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_TLS_REJECT_UNAUTHORIZED=

# Authorization: stub (current RolesGuard/ownership logic) | permify.
# permify requires PERMIFY_URL; proof scope is credit loan read only.
# Local server: docker compose -f infra/docker-compose.yml --profile permify up -d
AUTHORIZATION_DRIVER=stub
PERMIFY_URL=
PERMIFY_TENANT_ID=

# Ledger backend: stub (Postgres ledger authoritative) | tigerbeetle.
# LEGAL GATE: defaults OFF; tigerbeetle requires BOTH envs and is a
# proof-of-port only — not wired into money movement.
# Local replica: docker compose -f infra/docker-compose.yml --profile tigerbeetle up -d
LEDGER_DRIVER=stub
TIGERBEETLE_ADDRESSES=
TIGERBEETLE_CLUSTER_ID=

# Mojaloop interop: stub (deterministic simulated fixtures) | simulator.
# simulator requires MOJALOOP_SIM_URL (mojaloop-simulator / testing toolkit);
# proves the adapter contract only — no full Mojaloop switch is deployed.
MOJALOOP_DRIVER=stub
MOJALOOP_SIM_URL=
# Live adapter endpoints (MOJALOOP_DRIVER=live; contract for the live Mojaloop
# driver wave). Point at the compose TTK hub-emulator (profile "mojaloop",
# http://localhost:4040) or the Helm switch (infra/k8s/mojaloop/, service DNS
# in README). LOCAL-ONLY values; staging/prod targets come from env secrets.
MOJALOOP_ALS_ENDPOINT=
MOJALOOP_QUOTING_ENDPOINT=
MOJALOOP_TRANSFERS_ENDPOINT=
# Our DFSP identifier as onboarded in the switch/TTK (dev default agricdfsp).
MOJALOOP_DFSP_ID=

# OpenSearch demo admin password for the compose profile (LOCAL ONLY).
OPENSEARCH_ADMIN_PASSWORD=
# open-appsec SaaS profile token for the compose profile (optional; LOCAL ONLY).
APPSEC_AGENT_TOKEN=
# NOTE: OIDC_CLIENT_SECRET was removed (audit OR-04) — no code reads it; the
# API verifies tokens via OIDC_ISSUER/OIDC_AUDIENCE/OIDC_JWKS_* above.

# --- Stage 27 (WP-G10): OpenSearch request hardening ---
# Per-request timeout for the OpenSearch query-path driver (milliseconds,
# AbortController + race guard). Applies only when SEARCH_DRIVER=opensearch.
OPENSEARCH_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# WP-G18: lender catalogue (finance.lenders) provenance + production guard.
# lenderMatches is served from the database; every match is labelled with the
# catalogue row's source + verified flags. When the catalogue table is EMPTY
# the endpoint fails closed in production with 503 LENDER_CATALOGUE_UNAVAILABLE
# unless this is explicitly set to 'sample' (demos/fixture seeding only — the
# built-in catalogue is an unverified SAMPLE, clearly labelled; never real
# lender data).
LENDER_CATALOGUE=

# ---------------------------------------------------------------------------
# WP-G20: scheduled bridge sync jobs (Moodle/Discourse/Directus). Each job is
# OPT-IN (default off) and additionally requires the bridge's live driver to
# be configured (LMS_DRIVER/COMMUNITY_DRIVER/CMS_DRIVER non-stub with the
# bridge base URL + credentials) — otherwise the scheduled run no-ops with a
# logged reason and the manual sync endpoint answers 503.
# BRIDGE_SYNC_INTERVAL_MS defaults to 21600000 (6 hours).
BRIDGE_SYNC_MOODLE=false
BRIDGE_SYNC_DISCOURSE=false
BRIDGE_SYNC_DIRECTUS=false
BRIDGE_SYNC_INTERVAL_MS=
# Directus collection synced into advisory.items (kind 'guide').
DIRECTUS_COLLECTION=advisory

# --- Stage 27 innovation #20: Lender Lens (lender portfolio scorecards) ---
# Feature flag `lender-lens` is DB-backed and defaults OFF (enable via the
# admin feature-flags API). Scorecard JSON reads are served from Postgres
# (analytics.lender_scorecards, migration 079). The parquet+manifest export
# endpoint reuses the lakehouse object-storage config below and fails closed
# (503) when it is not configured — no export is ever fabricated.
# LAKEHOUSE_ENABLED=true
# LAKEHOUSE_BUCKET=
# LAKEHOUSE_S3_ENDPOINT=
# LAKEHOUSE_S3_REGION=
# LAKEHOUSE_S3_ACCESS_KEY=
# LAKEHOUSE_S3_SECRET_KEY=
# New Partner API scope for lender scorecard reads: portfolio:read (grant on
# the partner client; bound client-credentials tokens only).

# ---------------------------------------------------------------------------
# Stage 27 Innovation 16: Dealer QR Pay (feature flag `dealer-qr-pay`, OFF
# by default). Mojaloop merchant payments at agro-dealers with signed-voucher
# co-pay. The Mojaloop driver selection above (MOJALOOP_DRIVER + endpoints)
# governs the wallet leg: stub is the default and NEVER completes a payment;
# production with the stub adapter answers 503.
# HMAC secret for signing merchant QR payloads (voucher-crypto pattern).
# REQUIRED in production (>= 32 chars, high entropy; the development default
# is rejected there).
AGENT_QR_SECRET=
# Shared secret authenticating inbound Mojaloop transfer callbacks
# (POST /api/v1/agent-banking/qr-webhooks/mojaloop, header
# x-mojaloop-webhook-token). The route is disabled (404) while unset.
MOJALOOP_WEBHOOK_TOKEN=

# --- Stage 27 innovation #19: Agronomist SLA Console ---------------------
# Feature flag `agronomist-console` (DB-backed, default OFF) gates the
# /api/agronomist/* console surface.
# Business-hours SLA clock for voice.escalation_cases (UTC): an escalation
# is due this many BUSINESS hours after enqueue, counted only inside the
# window on the listed weekdays (0=Sunday..6=Saturday).
AGRONOMIST_SLA_BUSINESS_HOURS=4
AGRONOMIST_SLA_WINDOW_START=8
AGRONOMIST_SLA_WINDOW_END=17
AGRONOMIST_SLA_BUSINESS_DAYS=1,2,3,4,5
# Optional programme cohort tag stamped on new console cases (drives the
# per-cohort SLA deliverable export at GET /api/agronomist/sla-report).
AGRONOMIST_SLA_COHORT=
# Max answer-delivery attempts before the sweep stops retrying (failed
# deliveries stay honest: case remains assigned, never marked answered
# until the farmer's channel confirms).
AGRONOMIST_ANSWER_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# Audit OR-04: variables the code reads that were previously undocumented.
# Grouped by subsystem; every entry has a safe default (shown) or stays
# empty (feature off / fail-closed). Documentation placeholders only —
# provision real secrets via the deployment secret store.
# ---------------------------------------------------------------------------

# HTTP edge (bootstrap.ts)
# Trust X-Forwarded-For: hop count or proxy list; unset/false/0 = off (never
# enable on a direct-internet deployment — clients could spoof client IPs).
TRUST_PROXY=
# Allowed CORS origin for browser clients (default http://localhost:3000).
CORS_ORIGIN=http://localhost:3000
# JSON body size limit (default 1mb).
JSON_BODY_LIMIT=1mb

# Sessions (auth/session.service.ts)
# Refresh-token TTL in ms (default 30 days).
REFRESH_TOKEN_TTL_MS=
# Absolute session-family cap in days; token rotation cannot extend a family
# beyond this (default 90).
SESSION_FAMILY_MAX_AGE_DAYS=

# Observability
# Pino log level (default: debug in dev, info in production).
LOG_LEVEL=
# Set to 1 for pretty-printed local logs (default off).
LOG_PRETTY=
# Sentry error-tracking DSN; unset = error reporting disabled.
SENTRY_DSN=
# Deployment label stamped on telemetry (default: NODE_ENV).
DEPLOYMENT_ENVIRONMENT=

# Tamper-evident audit chain (core/audit*.ts)
# Periodic anchoring cadence in ms; unset/<=0 = scheduler disabled.
AUDIT_ANCHOR_INTERVAL_MS=
# Anchor sink: file:<path> or http(s)://<endpoint>; unset = anchoring off.
AUDIT_ANCHOR_SINK=
# Periodic hash-chain re-verification cadence in ms (default 0 = off; the
# admin endpoint remains the on-demand path). A broken chain logs at error.
AUDIT_CHAIN_VERIFY_INTERVAL_MS=

# Platform knobs
# Admin feature-flag cache TTL in ms (default 30000).
FEATURE_FLAG_CACHE_TTL_MS=
# Set true to run the in-process sweeper scheduler (escrow expiry, voucher
# stuck, sync-mutation retention); default off — k8s CronJobs are the
# production path.
SWEEPERS_ENABLED=false
# Notifications SSE stream poll interval in ms (default 5000).
NOTIFICATIONS_SSE_POLL_MS=
# Partner API client-credentials token TTL in seconds (default 900).
PARTNER_API_TOKEN_TTL_SECONDS=
# Outbound webhook delivery fetch timeout in ms (default 10000).
WEBHOOK_FETCH_TIMEOUT_MS=

# Voice + IVR privacy (NDPA 2023 retention)
# Voice-session TTL in ms; stale sessions accept no new turns (default 24h).
VOICE_SESSION_TTL_MS=
# Voice transcript retention in ms; older turns are hard-deleted by the
# retention sweep (default 30 days).
VOICE_TRANSCRIPT_RETENTION_MS=
# Business-hours SLA for voice escalation cases (default 24).
VOICE_CASE_SLA_HOURS=
# IVR DTMF digit-history retention in ms (default 1h); the call record
# itself lives until its own expiry sweep.
IVR_DTMF_RETENTION_MS=
# Salt (pepper) for the salted-HMAC MSISDN hashes in voice/IVR. Production
# enforces >= 32 chars and rejects the published dev default; generate per
# environment (openssl rand -hex 32) — never commit a real value.
MSISDN_HASH_SALT=

# Evidence blob storage (modules/evidence)
# Driver: stub (local, default) | s3.
EVIDENCE_STORAGE_DRIVER=stub
EVIDENCE_S3_BUCKET=
EVIDENCE_S3_ACCESS_KEY=
EVIDENCE_S3_SECRET_KEY=
# S3 region (default us-east-1) and custom endpoint (S3-compatible stores).
EVIDENCE_S3_REGION=
EVIDENCE_S3_ENDPOINT=
# Pre-signed download URL TTL in seconds.
EVIDENCE_PRESIGN_TTL_SECONDS=

# Credit + marketplace
# HMAC secret for credit-passport verification codes. Development falls back
# to a clearly-labelled dev default; production enforces >= 16 chars and
# rejects the published default (fail-closed).
CREDIT_PASSPORT_SECRET=
# Set true to require GPS coordinates on geo-sealed marketplace actions
# (default false).
GEO_SEALED_REQUIRE_GPS=false
# Provider-specific marketplace payment driver overrides; PAYMENT_DRIVER
# takes precedence when set. sandbox|production select the driver matching
# the configured secret key; 'stub' disables payments.
PAYSTACK_DRIVER=
FLUTTERWAVE_DRIVER=

# External provider clients
# Vendor timeout override for the OTP provider client (ms).
OTP_PROVIDER_TIMEOUT_MS=
# Vendor timeout override for the NIN identity provider client (ms).
NIN_PROVIDER_TIMEOUT_MS=
# Twilio sender number fallback (TWILIO_FROM_NUMBER takes precedence).
TWILIO_FROM=
# Live weather provider for parametric insurance: setting WEATHER_API_URL
# selects the HTTP provider and WEATHER_API_KEY is then required (unset =
# stub provider, default).
WEATHER_API_URL=
WEATHER_API_KEY=
# Flood-risk ML sidecar: stub (default) | http. http requires FLOOD_ML_URL.
FLOOD_ML_DRIVER=stub
FLOOD_ML_URL=

# Mojaloop live driver (MOJALOOP_DRIVER=live only)
# JWS signing key and mTLS certificate/key/CA bundle paths for switch
# communication; unset = no client auth material loaded.
MOJALOOP_JWS_SIGNING_KEY_PATH=
MOJALOOP_TLS_CERT_PATH=
MOJALOOP_TLS_KEY_PATH=
MOJALOOP_TLS_CA_PATH=

# TigerBeetle consistency checker (LEDGER_DRIVER=tigerbeetle)
# JSON array of {"accountCode", "tbAccountId"} pairs mapping Postgres ledger
# accounts to TigerBeetle account IDs for the consistency check.
TIGERBEETLE_ACCOUNT_MAP=

# Lakehouse export (see the Lender Lens block above for the S3 settings)
# Object key prefix for all exported objects (default 'lakehouse').
LAKEHOUSE_PREFIX=
