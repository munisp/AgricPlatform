# Core
# NOTE: APP_NAME, WEB_URL and API_URL were removed (audit OR-04) — no code
# reads them; deployment manifests set them for infra labelling only.
NODE_ENV=development
PORT=3001

# Web (Next.js public env — documentation only, no secrets)
# Base URL of the NestJS API consumed by the browser client.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# GeoPortal (/map) basemap tiles — raster tile URL template consumed by
# MapLibre GL. Default (unset): OpenStreetMap https://tile.openstreetmap.org/{z}/{x}/{y}.png
# (attribution shown on the map). Any keyless tile endpoint works; the
# origin is added to CSP img-src/connect-src at build time. NO API keys
# here — pick a keyless source or self-host tiles.
#NEXT_PUBLIC_MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# DuckDB-WASM asset origin for the geoportal's on-demand spatial queries
# (default: https://cdn.jsdelivr.net — duckdb-wasm's own bundle URLs).
# Self-host the four dist files (duckdb-{mvp,eh}.wasm + browser workers)
# to keep all traffic first-party; the origin is added to CSP connect-src.
#NEXT_PUBLIC_DUCKDB_CDN=https://cdn.jsdelivr.net

# Persistence (PostgreSQL + Redis)
# DATABASE_URL selects the pg repositories; without it the API boots on the
# in-memory implementations (development/test only). In production boot fails
# closed unless ALLOW_INMEMORY_PERSISTENCE=true is set explicitly (break-glass
# local drills only — state is lost on restart).
DATABASE_URL=postgresql://agric:agric@localhost:5432/agric_platform
ALLOW_INMEMORY_PERSISTENCE=false
# REDIS_URL selects the shared idempotency/OTP stores; without it in-memory
# stores keep single-instance semantics. Production fails closed unless
# ALLOW_INMEMORY_CACHE=true (break-glass only).
REDIS_URL=redis://localhost:6379
ALLOW_INMEMORY_CACHE=false
# PostgreSQL pool sizing + statement safety bounds (WP-G7). Unset/invalid
# values fall back to the defaults below. statement_timeout is enforced
# server-side; query_timeout is the client-side socket bound (default:
# statement_timeout + 5s slack so Postgres cancels first with a clean
# error). Raise PG_STATEMENT_TIMEOUT_MS if the admin analytics mart exports
# ever legitimately exceed 30s.
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONN_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=30000
PG_QUERY_TIMEOUT_MS=
# After provisioning the database:
#   npm run migrate -w @agric-platform/api   (apply infra/postgres/*.sql)
#   npm run seed -w @agric-platform/api      (load demo seed data)

# Identity
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=agric-platform
KEYCLOAK_CLIENT_ID=agric-web
# API-side OIDC verification (required in production). Bearer tokens are
# verified against the realm JWKS: OIDC_JWKS_URI overrides the derived
# <issuer>/protocol/openid-connect/certs endpoint; OIDC_JWKS_JSON supplies
# the JWKS inline (takes precedence over the URI; offline/key-rotation use).
OIDC_ISSUER=http://localhost:8080/realms/agric-platform
OIDC_AUDIENCE=agric-web
OIDC_JWKS_URI=
OIDC_JWKS_JSON=
# Optional Keycloak-backed phone-auth token exchange (default off). When
# PHONE_AUTH_KEYCLOAK=true the API exchanges phone+OTP for realm tokens as
# the confidential client, which requires KEYCLOAK_CLIENT_SECRET.
PHONE_AUTH_KEYCLOAK=false
KEYCLOAK_CLIENT_SECRET=
PHONE_AUTH_KEYCLOAK_TIMEOUT_MS=
ALLOW_DEV_HEADER_AUTH=false
ENABLE_API_DOCS=false

# Integration drivers: stub | sandbox | production
SMS_DRIVER=stub
WHATSAPP_DRIVER=stub
EMAIL_DRIVER=stub
PUSH_DRIVER=stub
PAYMENT_DRIVER=stub
# Escrow payout rail (Stage 23): stub | live. stub is a labelled local driver
# (default outside production); in production a stub/unset driver makes escrow
# release/refund fail closed with 503 at use-time. live requires the
# PAYOUT_PROVIDER_* credentials below and still returns 503 until the PSSP
# disbursement client is integrated.
ESCROW_PAYOUT_DRIVER=stub
SEARCH_DRIVER=stub
WEATHER_DRIVER=stub
LMS_DRIVER=stub
COMMUNITY_DRIVER=stub
CMS_DRIVER=stub

# Provider credentials (never commit real values)
TERMII_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_360DIALOG_API_KEY=
MAILGUN_API_KEY=
SENDGRID_API_KEY=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
# PSSP disbursement rail credentials (Stage 23; required only when
# ESCROW_PAYOUT_DRIVER=live — dummy placeholder values, never real secrets)
PAYOUT_PROVIDER_URL=
PAYOUT_PROVIDER_API_KEY=
PAYOUT_PROVIDER_SIGNING_SECRET=
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=
MOODLE_BASE_URL=
MOODLE_TOKEN=
DISCOURSE_BASE_URL=
DISCOURSE_API_KEY=
DIRECTUS_BASE_URL=
DIRECTUS_TOKEN=

# --- Wave P1 live provider drivers (documentation only — no real secrets) ---
# SMS: Termii primary + Twilio failover. Live SMS_DRIVER requires Termii
# (key + registered sender) or the full Twilio triple.
TERMII_SENDER_ID=
TWILIO_FROM_NUMBER=
# WhatsApp via 360dialog: WABA namespace for approved templates (optional).
WHATSAPP_360DIALOG_NAMESPACE=
# Email: Mailgun preferred (key + domain); SendGrid alternate. EMAIL_FROM
# overrides the default sender for both.
MAILGUN_DOMAIN=
EMAIL_FROM=
# Flutterwave webhook secret (audit A3-10: the verifier reads
# FLUTTERWAVE_WEBHOOK_SECRET, falling back to the shared
# WEBHOOK_SIGNING_SECRET — the previously documented FLUTTERWAVE_VERIF_HASH
# was never read and configured a dead variable).
FLUTTERWAVE_WEBHOOK_SECRET=
# Search: Meilisearch index name override (default agric-platform).
MEILISEARCH_INDEX=
# Weather: WEATHER_DRIVER=sandbox|production enables the keyless Open-Meteo
# feed (no credentials) with a 15-minute Redis/in-memory cache.
# Planting-Window Pulse (Stage 27, feature flag 'planting-window-pulse',
# default OFF): per-plot advisories are generated ONLY from the live weather
# driver — with WEATHER_DRIVER=stub the dispatch run records
# basis='unavailable' and suppresses every send (never fabricates a window).
# ADVISORY_PULSE_INTERVAL_MS: minimum gap between pushes per subscription
# (default 7 days). ADVISORY_PULSE_FORECAST_MAX_AGE_MS: freshness gate — a
# forecast older than this never generates an advisory (default 1 hour; the
# 15-minute driver cache keeps real fetches far fresher).
ADVISORY_PULSE_INTERVAL_MS=
ADVISORY_PULSE_FORECAST_MAX_AGE_MS=
# Market data: scheduled FEWS NET / NiMet price ingestion into
# advisory.commodity_prices; enabled only with MARKET_DATA_DRIVER=live (or
# sandbox/production) AND at least one feed key.
MARKET_DATA_DRIVER=stub
FEWS_NET_API_KEY=
NIMET_API_KEY=
FEWS_NET_BASE_URL=
NIMET_BASE_URL=
MARKET_DATA_POLL_INTERVAL_MS=
# Price Wire (Stage 27, feature flag 'price-wire', default OFF): subscribed
# crop-price ticker over SMS/WhatsApp + USSD pull node 6 + public embed
# quote endpoint. Quotes are resolved from ingested FEWS NET / NiMet
# observations first (basis 'live') and the COMMODITY_PRICE_DRIVER provider
# port second. Feed keys absent → provider port STUB → quotes carry
# basis='stub' and dispatches are SUPPRESSED in production (never SMS a
# fabricated price); the USSD pull answers "price unavailable" honestly.
# PRICE_WIRE_QUOTE_MAX_AGE_MS: freshness gate — a quote whose observation is
# older than this is never sent (default 7 days).
# PRICE_WIRE_DAILY_INTERVAL_MS / PRICE_WIRE_WEEKLY_INTERVAL_MS: minimum gap
# between pushes per subscription for each cadence (defaults 1 day / 7 days).
PRICE_WIRE_QUOTE_MAX_AGE_MS=
PRICE_WIRE_DAILY_INTERVAL_MS=
PRICE_WIRE_WEEKLY_INTERVAL_MS=
# Discourse API username for the bridge client (default: system).
DISCOURSE_API_USERNAME=

# --- Wave P5b USSD channel (documentation only — no real secrets) ---
# Africa's Talking USSD callback (POST /api/v1/ussd/callback) stays disabled
# until USSD_DRIVER=live|sandbox AND both credentials are set. In production
# the API refuses to boot when the driver flag is set without the
# credentials (fail-closed, same pattern as the wave P1 adapters).
USSD_DRIVER=stub
AT_API_KEY=
AT_USERNAME=
# Callback authenticity (audit C2-3, hardened Stage 24): AT does NOT sign
# callbacks, so this shared secret is the ONLY authenticity check on the AT
# callbacks (ussd, ivr, agent-banking/ussd). PREFERRED transport is the
# x-at-callback-token request header; the ?token= query param (embedded in
# the AT dashboard callback URL, e.g. .../ussd/callback?token=<value>) is
# accepted for AT compatibility — request logs strip query strings so it is
# never written to the log pipeline. Deliberately EMPTY here (same doctrine
# as production secrets): production refuses to boot a live|sandbox driver
# without it, and rejects published placeholders ('replace-me',
# 'local-development-only') and values shorter than 32 chars. Generate per
# environment (openssl rand -hex 32) — never commit a real value.
AT_CALLBACK_TOKEN=
# Optional comma-separated source-IP allowlist for the AT callbacks
# (empty = disabled). 403s any caller outside the list.
AT_CALLBACK_IP_ALLOWLIST=
# Session sweeper cadence override (default 60000 ms; sessions themselves
# expire after a fixed 3-minute inactivity window).
USSD_SWEEP_INTERVAL_MS=
# --- End wave P5b block ---

# --- Wave P6a IVR voice channel (documentation only — no real secrets) ---
# Africa's Talking Voice callback (POST /api/v1/ivr/callback) stays disabled
# until IVR_DRIVER=live|sandbox AND both credentials are set (the same
# AT_API_KEY/AT_USERNAME pair as USSD). In production the API refuses to
# boot when the driver flag is set without the credentials (fail-closed,
# same pattern as the wave P1 adapters). The callback is authenticated by
# the shared AT_CALLBACK_TOKEN / AT_CALLBACK_IP_ALLOWLIST (see the wave P5b
# block above).
IVR_DRIVER=stub
# Call sweeper cadence override (default 60000 ms; call rows themselves
# expire after a fixed 10-minute inactivity window).
IVR_SWEEP_INTERVAL_MS=
# --- End wave P6a block ---

# --- Wave AGENTBANK agent banking (documentation only — no real secrets) ---
# HMAC key for the signed offline-voucher payload. Development falls back to
# a clearly-labelled INSECURE default; in production the API refuses to boot
# without a real secret (fail-closed, same pattern as the signing keys).
# Generate per environment (e.g. openssl rand -hex 32) and store only in the
# GitHub Environment / cloud secret manager — never commit a real value.
AGENT_VOUCHER_SECRET=
# Farmer presence-proof (OTP) driver. stub (default): deterministic dev
# channel, nothing is sent — FORBIDDEN in production (the stub code is
# publicly computable; production boot aborts unless OTP_DRIVER=live).
# live: reserved for a real OTP vendor — requires both credentials and fails
# closed (503 on every verification) until a provider client is integrated;
# production boots refuse missing config.
OTP_DRIVER=stub
OTP_PROVIDER_URL=
OTP_PROVIDER_API_KEY=
# --- End wave AGENTBANK block ---

# --- Wave NINVOUCHER input vouchers (documentation only — no real secrets) ---
# Salt for the salted-HMAC NIN hash (plaintext NIN is NEVER persisted — only
# hash + last-3 mask). Development falls back to a clearly-labelled dev
# default; production refuses to boot without a real per-environment salt.
NIN_HASH_SALT=
# Identity verification driver. stub (default): deterministic, clearly
# labelled. live: reserved for NIMC/licensed vendor — requires both
# credentials, fails closed (503) until integrated; production aborts when
# the flag is set without config.
NIN_DRIVER=stub
NIN_PROVIDER_URL=
NIN_PROVIDER_API_KEY=
# --- End wave NINVOUCHER block ---

# --- Wave LIVESTOCK passport (documentation only — no real secrets) ---
# HMAC key for the public livestock-passport verification codes. Development
# falls back to a clearly-labelled INSECURE default; production refuses to
# boot without a real secret (fail-closed, same pattern as the signing keys).
LIVESTOCK_PASSPORT_SECRET=
# National animal-ID authority port. stub (default): deterministic, clearly
# labelled STUB-NAIS-*. live: reserved for the state veterinary authority /
# RFID tag registry — requires both credentials, fails closed (503) until
# integrated; production aborts when the flag is set without config.
ANIMAL_ID_AUTHORITY_MODE=stub
ANIMAL_ID_AUTHORITY_URL=
ANIMAL_ID_AUTHORITY_API_KEY=
# --- End wave LIVESTOCK block ---

# Security
# NOTE: JWT_SECRET was removed (audit A3-10) — no code reads it; bearer
# tokens are verified against the Keycloak realm JWKS (see OIDC_* above).
WEBHOOK_SIGNING_SECRET=local-development-only

# ---------------------------------------------------------------------------
# Production-required secrets/drivers previously undocumented (audit A3-10).
# Documentation placeholders only — provision real values via the deployment
# secret store; the API fails closed in production without them.
# ---------------------------------------------------------------------------
# HMAC signing secrets (production enforces >= 32 chars and rejects the
# published development defaults):
#   ATTENDANCE_SIGNING_SECRET  — event attendance QR codes (chapters)
#   VET_SIGNING_SECRET         — vet health-record signatures (livestock-health)
#   WAREHOUSE_RECEIPT_SECRET   — e-WHR warehouse receipt signatures
ATTENDANCE_SIGNING_SECRET=
VET_SIGNING_SECRET=
WAREHOUSE_RECEIPT_SECRET=
# Partner API (wave P5d): production requires the live driver and a private
# HS256 signing secret (>= 16 chars, never the published dev secret).
PARTNER_API_DRIVER=stub
PARTNER_API_SIGNING_SECRET=
# Observability: bearer token guarding the /metrics endpoint in production.
METRICS_TOKEN=
# Warehouse e-WHR external rails (default stub; live requires URL + key).
WAREHOUSE_CERTIFICATION_DRIVER=stub
WAREHOUSE_CERTIFICATION_URL=
WAREHOUSE_CERTIFICATION_API_KEY=
COLLATERAL_REGISTRY_DRIVER=stub
COLLATERAL_REGISTRY_URL=
COLLATERAL_REGISTRY_API_KEY=
# Commodity price provider for advisory (stub | http + COMMODITY_PRICE_API_URL).
COMMODITY_PRICE_DRIVER=stub
COMMODITY_PRICE_API_URL=
# Voice agronomist ASR/TTS drivers (stub | live + API keys).
ASR_DRIVER=stub
ASR_API_KEY=
TTS_DRIVER=stub
TTS_API_KEY=
# Geo-verified credit scoring: shadow (default, advisory) | off (endpoints disabled).
GEO_CREDIT_MODE=shadow
# Shadow-score fixture escape hatch (WP-G15). In production, shadow scores
# derived from stub provider fixtures are computed but NOT persisted unless
# this is explicitly true. Default off — never set true in real production.
SHADOW_FIXTURES=false
# Government disease-notification webhook (https only; unset = fail closed).
DISEASE_NOTIFICATION_URL=
# Crop ML sidecar (stub | http + URL; CROP_ML_TIMEOUT_MS, CROP_ML_RETRIES,
# CROP_ML_CIRCUIT_THRESHOLD, CROP_ML_CIRCUIT_COOLDOWN_MS, CROP_ML_HEALTH_TIMEOUT_MS
# tune the client).
CROP_ML_DRIVER=stub
CROP_ML_URL=

