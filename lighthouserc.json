{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "settings": {
        "emulatedFormFactor": "mobile",
        "throttlingMethod": "simulate",
        "throttling": {
          "rttMs": 300,
          "throughputKbps": 700,
          "cpuSlowdownMultiplier": 4
        }
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.8 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
