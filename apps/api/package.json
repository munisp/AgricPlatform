{
  "name": "@agric-platform/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NestJS modular API for AgricPlatform (NYFN PRD v3.3 Phase 1).",
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "npm run build -w @agric-platform/shared",
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "npm run build -w @agric-platform/shared && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "migrate": "tsx src/database/migrate.ts",
    "seed": "tsx src/database/seed.ts",
    "worker:temporal": "npm run build && node dist/workers/temporal.worker.js"
  },
  "dependencies": {
    "@agric-platform/shared": "0.1.0",
    "@aws-sdk/client-s3": "^3.1101.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@opensearch-project/opensearch": "^3.6.0",
    "@sentry/nestjs": "^10.69.0",
    "@temporalio/client": "^1.21.1",
    "@temporalio/worker": "^1.21.1",
    "@temporalio/workflow": "^1.21.1",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "h3-js": "^4.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.2",
    "jose": "^6.2.7",
    "kafkajs": "^2.2.4",
    "nestjs-pino": "^4.6.1",
    "parquetjs-lite": "^0.8.7",
    "pdfkit": "^0.19.1",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ssh2": "^1.17.0",
    "tigerbeetle-node": "^0.17.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@swc/core": "^1.10.0",
    "@types/express": "^5.0.0",
    "@types/node": "^20.19.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "@types/ssh2": "^1.15.5",
    "eslint": "^9.39.5",
    "pgsql-ast-parser": "^12.0.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "unplugin-swc": "^1.5.1",
    "vitest": "^3.2.4"
  }
}
