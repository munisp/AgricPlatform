# AgricPlatform API environment template. Never commit real secrets.
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000
JSON_BODY_LIMIT=1mb

# Identity (Keycloak OIDC). REQUIRED in production: the API refuses to boot
# without OIDC_ISSUER (or KEYCLOAK_URL + KEYCLOAK_REALM).
OIDC_ISSUER=http://localhost:8080/realms/agric-platform
# OIDC_JWKS_URI defaults to <issuer>/protocol/openid-connect/certs
OIDC_JWKS_URI=
OIDC_AUDIENCE=agric-web
# Inline JWKS JSON for tests/local only; never set in deployed environments.
OIDC_JWKS_JSON=
# Break-glass only: allow x-user-id header auth in production (default: off).
ALLOW_DEV_HEADER_AUTH=false

# API documentation (Swagger at /api/v1/docs) is off in production unless enabled.
ENABLE_API_DOCS=false

# Integration drivers: stub (default, no network) | sandbox | production
SMS_DRIVER=stub
WHATSAPP_DRIVER=stub
EMAIL_DRIVER=stub
PUSH_DRIVER=stub
PAYMENT_DRIVER=stub
LMS_DRIVER=stub
COMMUNITY_DRIVER=stub
CMS_DRIVER=stub
WEATHER_DRIVER=stub
SEARCH_DRIVER=stub

# Provider credentials (leave empty to stay on stub drivers)
TERMII_API_KEY=
WHATSAPP_360DIALOG_API_KEY=
MAILGUN_API_KEY=
SENDGRID_API_KEY=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
MOODLE_BASE_URL=
MOODLE_TOKEN=
DISCOURSE_BASE_URL=
DISCOURSE_API_KEY=
DIRECTUS_BASE_URL=
DIRECTUS_TOKEN=
WEATHER_API_KEY=
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=

# --- Wave P1 live provider drivers (documentation only — never commit real secrets) ---
# SMS: Termii is primary; Twilio is the failover rail. With SMS_DRIVER live,
# the API refuses to boot unless Termii (key + sender) or the full Twilio
# triple is present. TERMII_SENDER_ID must be a registered DND-route sender.
TERMII_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# WhatsApp via 360dialog: WABA namespace for approved templates (optional).
WHATSAPP_360DIALOG_NAMESPACE=
# Email: Mailgun preferred (key + domain); SendGrid is the alternate.
# EMAIL_FROM overrides the default sender for both providers.
MAILGUN_DOMAIN=
EMAIL_FROM=
# Push: OneSignal app credentials (PUSH_DRIVER live requires both).
# Payments: PAYSTACK_SECRET_KEY / FLUTTERWAVE_SECRET_KEY above; webhook
# signature secrets below. Flutterwave's verif-hash for its webhook rail:
FLUTTERWAVE_VERIF_HASH=
# Search: Meilisearch index name override (default agric-platform).
MEILISEARCH_INDEX=
# Weather: WEATHER_DRIVER=sandbox|production switches advisory snapshots to
# the keyless Open-Meteo feed (no credentials needed) with a 15-minute cache.
# Market data: scheduled FEWS NET / NiMet commodity price ingestion into
# advisory.commodity_prices. Disabled unless MARKET_DATA_DRIVER=live (or
# sandbox/production) AND at least one feed key is present.
MARKET_DATA_DRIVER=stub
FEWS_NET_API_KEY=
NIMET_API_KEY=
# Optional base URL overrides for the feed/bridge endpoints (sandboxes).
FEWS_NET_BASE_URL=
NIMET_BASE_URL=
# Poll cadence for the ingestion scheduler (default 21600000 = 6h).
MARKET_DATA_POLL_INTERVAL_MS=
# Discourse API username for the bridge client (default: system).
DISCOURSE_API_USERNAME=

# Webhook signature secrets (HMAC-SHA256 over the raw request body).
# Per-provider secrets take precedence over the shared fallback.
WEBHOOK_SIGNING_SECRET=local-development-only
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_WEBHOOK_SECRET=
TERMII_WEBHOOK_SECRET=

# Observability (plan workstream A)
# Log level (default: info in production, debug otherwise).
LOG_LEVEL=
# Pretty-print logs locally (dev only; never in production).
LOG_PRETTY=0
# Error tracking. Leave empty to keep Sentry fully disabled (SDK is only
# loaded when a DSN is set). Never commit a real DSN.
SENTRY_DSN=
# Prometheus scrape endpoint: GET /api/v1/metrics (no auth; restrict at the edge).
