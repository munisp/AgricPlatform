# AgricPlatform API environment template. Never commit real secrets.
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000
JSON_BODY_LIMIT=1mb

# Identity (Keycloak OIDC). REQUIRED in production: the API refuses to boot
# without OIDC_ISSUER (or KEYCLOAK_URL + KEYCLOAK_REALM).
OIDC_ISSUER=http://localhost:8080/realms/agric-platform
# OIDC_JWKS_URI defaults to <issuer>/protocol/openid-connect/certs
OIDC_JWKS_URI=
OIDC_AUDIENCE=agric-web
# Inline JWKS JSON for tests/local only; never set in deployed environments.
OIDC_JWKS_JSON=
# Break-glass only: allow x-user-id header auth in production (default: off).
ALLOW_DEV_HEADER_AUTH=false

# API documentation (Swagger at /api/v1/docs) is off in production unless enabled.
ENABLE_API_DOCS=false

# Integration drivers: stub (default, no network) | sandbox | production
SMS_DRIVER=stub
WHATSAPP_DRIVER=stub
EMAIL_DRIVER=stub
PUSH_DRIVER=stub
PAYMENT_DRIVER=stub
LMS_DRIVER=stub
COMMUNITY_DRIVER=stub
CMS_DRIVER=stub
WEATHER_DRIVER=stub
SEARCH_DRIVER=stub

# Provider credentials (leave empty to stay on stub drivers)
TERMII_API_KEY=
WHATSAPP_360DIALOG_API_KEY=
MAILGUN_API_KEY=
SENDGRID_API_KEY=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
MOODLE_BASE_URL=
MOODLE_TOKEN=
DISCOURSE_BASE_URL=
DISCOURSE_API_KEY=
DIRECTUS_BASE_URL=
DIRECTUS_TOKEN=
WEATHER_API_KEY=
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=

# Webhook signature secrets (HMAC-SHA256 over the raw request body).
# Per-provider secrets take precedence over the shared fallback.
WEBHOOK_SIGNING_SECRET=local-development-only
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_WEBHOOK_SECRET=
TERMII_WEBHOOK_SECRET=

# Observability (plan workstream A)
# Log level (default: info in production, debug otherwise).
LOG_LEVEL=
# Pretty-print logs locally (dev only; never in production).
LOG_PRETTY=0
# Error tracking. Leave empty to keep Sentry fully disabled (SDK is only
# loaded when a DSN is set). Never commit a real DSN.
SENTRY_DSN=
# Prometheus scrape endpoint: GET /api/v1/metrics (no auth; restrict at the edge).
