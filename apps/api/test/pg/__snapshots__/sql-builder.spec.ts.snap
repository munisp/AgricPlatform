exports[`criteria SQL builders > user criteria (roles EXISTS + ILIKE q) 2`] = `
{
  "params": [
    "farmer",
  ],
  "where": " WHERE (EXISTS (SELECT 1 FROM identity.user_roles ur2
                      WHERE ur2.user_id = u.id AND ur2.role_code = $1))",
}
`;

