exports[`criteria SQL builders > advisory + marketplace criteria 1`] = `
{
  "params": [
    "price",
    "Kano",
    "maize",
  ],
  "where": " WHERE (kind = $1) AND (state = $2) AND (crop = $3)",
}
`;

exports[`criteria SQL builders > advisory + marketplace criteria 2`] = `
{
  "params": [
    "produce",
    "Kano",
    "maize",
    true,
    "%maize%",
  ],
  "where": " WHERE (kind = $1) AND (location_state = $2) AND (crop = $3) AND (is_active = $4) AND (title ILIKE $5)",
}
`;

