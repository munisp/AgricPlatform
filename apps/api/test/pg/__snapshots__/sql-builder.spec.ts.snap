}
`;

exports[`criteria SQL builders > user criteria (roles EXISTS + ILIKE q) 4`] = `
{
  "params": [
    "buyer",
    "%aisha%",
    "%aisha%",
  ],
  "where": " WHERE (EXISTS (SELECT 1 FROM identity.user_roles ur2
                      WHERE ur2.user_id = u.id AND ur2.role_code = $1)) AND ((u.full_name ILIKE $2 OR u.phone ILIKE $3))",
}
`;
